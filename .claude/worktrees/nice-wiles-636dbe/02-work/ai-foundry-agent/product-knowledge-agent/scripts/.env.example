# Azure AI Search
SEARCH_ENDPOINT=https://srch-product-knowledge.search.windows.net
SEARCH_ADMIN_KEY=YOUR_SEARCH_ADMIN_KEY_HERE

# Azure OpenAI
OPENAI_ENDPOINT=https://aoai-product-knowledge.openai.azure.com/
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Azure Blob Storage
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=productkbstoragepoc;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
STORAGE_BASE_URL=https://productkbstoragepoc.blob.core.windows.net/diagrams

# Prompt Flow Endpoint (fill in after Phase 3, Step 3.12 deployment)
# Find in: AI Foundry → Deployments → product-knowledge-endpoint → REST endpoint URL
PROMPT_FLOW_ENDPOINT=https://product-knowledge-endpoint.eastus2.inference.ml.azure.com/score
# Find in: AI Foundry → Deployments → product-knowledge-endpoint → Authentication tab → Primary key
PROMPT_FLOW_KEY=YOUR_PROMPT_FLOW_PRIMARY_KEY_HERE
