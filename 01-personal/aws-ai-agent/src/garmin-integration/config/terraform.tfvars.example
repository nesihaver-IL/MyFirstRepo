# Terraform Variables Configuration Example
# Copy this file to terraform.tfvars and fill in your values

# AWS Configuration
aws_region  = "us-east-1"
environment = "dev"

# Project Configuration
project_name = "garmin-integration"

# Garmin API Credentials (Required - Get from https://developer.garmin.com/)
garmin_consumer_key    = "your-garmin-consumer-key-here"
garmin_consumer_secret = "your-garmin-consumer-secret-here"

# Bedrock Configuration (Optional - leave empty to use direct model invocation)
bedrock_agent_id       = ""  # Your Bedrock Agent ID if using agent
bedrock_agent_alias_id = ""  # Your Bedrock Agent Alias ID
bedrock_model_id       = "anthropic.claude-3-5-sonnet-20241022-v2:0"

# Lambda Configuration
lambda_timeout     = 300  # seconds
lambda_memory_size = 512  # MB

# DynamoDB Configuration
dynamodb_billing_mode = "PAY_PER_REQUEST"  # or "PROVISIONED"

# Monitoring Configuration
enable_xray_tracing = true
log_retention_days  = 30

# API Gateway Configuration
api_gateway_stage_name = "prod"
