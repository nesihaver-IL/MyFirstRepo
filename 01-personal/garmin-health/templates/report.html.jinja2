<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Garmin Health Report — {{ report_date }}</title>
<style>
  /* ── Reset & base ─────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 15px; line-height: 1.6; color: #1a1a2e;
    background: #f5f7fa; padding: 0 0 60px;
  }
  /* ── Header ───────────────────────────────────────────────── */
  .header {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    color: #fff; padding: 36px 40px 28px;
  }
  .header h1 { font-size: 26px; font-weight: 700; margin-bottom: 6px; }
  .header .meta { opacity: 0.75; font-size: 13px; }
  /* ── Container ────────────────────────────────────────────── */
  .container { max-width: 860px; margin: 0 auto; padding: 32px 24px 0; }
  /* ── Section cards ────────────────────────────────────────── */
  .card {
    background: #fff; border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,.07);
    padding: 24px 28px; margin-bottom: 24px;
  }
  .card h2 {
    font-size: 16px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: #0f3460; margin-bottom: 16px;
    padding-bottom: 10px; border-bottom: 2px solid #e8ecf0;
  }
  /* ── Alert badges ─────────────────────────────────────────── */
  .alert-table { width: 100%; border-collapse: collapse; }
  .alert-table td { padding: 9px 12px; vertical-align: top; font-size: 14px; }
  .alert-table tr + tr td { border-top: 1px solid #f0f0f0; }
  .badge {
    display: inline-block; padding: 3px 10px; border-radius: 12px;
    font-size: 11px; font-weight: 700; letter-spacing: .05em; white-space: nowrap;
  }
  .badge-RED    { background: #fee2e2; color: #991b1b; }
  .badge-YELLOW { background: #fef9c3; color: #854d0e; }
  .badge-INFO   { background: #dbeafe; color: #1e40af; }
  /* ── Metrics table ────────────────────────────────────────── */
  .metrics-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .metrics-table th {
    text-align: left; padding: 8px 12px; background: #f8f9fb;
    font-size: 12px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .05em; color: #64748b;
    border-bottom: 2px solid #e8ecf0;
  }
  .metrics-table td { padding: 9px 12px; border-bottom: 1px solid #f0f4f8; }
  .metrics-table tr:last-child td { border-bottom: none; }
  .pillar-run  { color: #16a34a; font-weight: 600; }
  .pillar-swim { color: #0284c7; font-weight: 600; }
  .pillar-sleep{ color: #7c3aed; font-weight: 600; }
  .pillar-fit  { color: #ea580c; font-weight: 600; }
  /* ── AI Analysis ──────────────────────────────────────────── */
  .analysis-body { font-size: 14px; line-height: 1.75; color: #374151; }
  .analysis-body h3 {
    font-size: 15px; font-weight: 700; color: #0f3460;
    margin: 20px 0 8px; padding-bottom: 4px;
    border-bottom: 1px solid #e8ecf0;
  }
  .analysis-body h3:first-child { margin-top: 0; }
  .analysis-body ul { padding-left: 20px; margin: 6px 0 12px; }
  .analysis-body li { margin-bottom: 4px; }
  .analysis-body p  { margin-bottom: 10px; }
  /* ── Footer ───────────────────────────────────────────────── */
  .footer {
    text-align: center; font-size: 12px; color: #94a3b8;
    margin-top: 8px; padding: 0 24px;
  }
  /* ── No-alerts notice ─────────────────────────────────────── */
  .no-alerts {
    font-size: 14px; color: #16a34a; font-weight: 600;
    display: flex; align-items: center; gap: 8px;
  }
</style>
</head>
<body>

<div class="header">
  <h1>Garmin Health Report</h1>
  <div class="meta">
    Analysis period: Last {{ days }} days &nbsp;|&nbsp;
    Generated: {{ generated_at }}
  </div>
</div>

<div class="container">

  <!-- ── ALERTS ─────────────────────────────────────────────── -->
  <div class="card">
    <h2>Alerts</h2>
    {% if alerts %}
    <table class="alert-table">
      {% for alert in alerts %}
      <tr>
        <td style="width:100px">
          <span class="badge badge-{{ alert.severity }}">{{ alert.severity }}</span>
        </td>
        <td>{{ alert.message }}</td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <div class="no-alerts">✅ No alerts — all metrics within target ranges.</div>
    {% endif %}
  </div>

  <!-- ── METRICS SNAPSHOT ───────────────────────────────────── -->
  <div class="card">
    <h2>Key Metrics — Last {{ days }} Days</h2>
    <table class="metrics-table">
      <thead>
        <tr>
          <th>Pillar</th>
          <th>Metric</th>
          <th>Value</th>
          <th>Context</th>
        </tr>
      </thead>
      <tbody>
        {% for row in metrics_rows %}
        <tr>
          <td>
            {% if row.pillar == "Running" %}<span class="pillar-run">🏃 Running</span>
            {% elif row.pillar == "Swimming" %}<span class="pillar-swim">🏊 Swimming</span>
            {% elif row.pillar == "Sleep" %}<span class="pillar-sleep">😴 Sleep</span>
            {% else %}<span class="pillar-fit">💪 Fitness</span>{% endif %}
          </td>
          <td>{{ row.metric }}</td>
          <td><strong>{{ row.value }}</strong></td>
          <td style="color:#64748b">{{ row.context }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- ── AI ANALYSIS ────────────────────────────────────────── -->
  <div class="card">
    <h2>AI Analysis</h2>
    <div class="analysis-body">
      {{ analysis_html | safe }}
    </div>
  </div>

</div><!-- /container -->

<div class="footer">
  Generated by Garmin Health Pipeline &nbsp;·&nbsp;
  Model: claude-sonnet-4-6 &nbsp;·&nbsp;
  {{ generated_at }}
</div>

</body>
</html>
