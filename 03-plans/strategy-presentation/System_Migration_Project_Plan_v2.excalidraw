      "strokeWidth": 1.5
    },
    {
      "id": "183b9d38-451",
      "type": "text",
      "x": 530,
      "y": 820,
      "width": 400,
      "height": 25,
      "text": "MDE: Dual-Delivery Plugins",
      "fontSize": 11,
      "fontFamily": 1,
      "fontStyle": "bold",
      "backgroundColor": "transparent"
    },
    {
      "id": "9244fa9a-362",
      "type": "text",
      "x": 530,
      "y": 850,
      "width": 400,
      "height": 310,
      "text": "Components requiring\ndual-delivery support:\n\n1. EDR (Error Detection\n   & Recovery)\n   \n2. AA (Automated Audit)\n\n3. VR (Validation &\n   Reconciliation)\n\n❓ Additional plugins?\n   Owner: Issler, Shlomo\n   \n⚠️ CRITICAL: Incomplete\n   plugin list → failures",
      "fontSize": 9,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "backgroundColor": "transparent"
    },
    {
      "id": "215ba502-2ab",
