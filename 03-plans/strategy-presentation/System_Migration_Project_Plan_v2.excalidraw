    {
      "id": "255e25e5-d7c",
      "type": "text",
      "x": 80,
      "y": 820,
      "width": 400,
      "height": 25,
      "text": "SAU: Multi-Domain Delivery",
      "fontSize": 11,
      "fontFamily": 1,
      "fontStyle": "bold",
      "backgroundColor": "transparent"
    },
    {
      "id": "5a0e6b24-cb4",
      "type": "text",
      "x": 80,
      "y": 850,
      "width": 400,
      "height": 310,
      "text": "MSMQ vs Kafka Decision:\n━━━━━━━━━━━━━━━━━━━\nOption 1: MSMQ first\n→ Kafka in Phase 2\n\nOption 2: Kafka from Day 1\n→ Better scalability\n\nDecision Required:\nOwner: Keren, Zhaneta\n\nMust deliver to:\n• Vx 19.X (Old UDC)\n• Vx 22.14 (New UDC)",
      "fontSize": 9,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "backgroundColor": "transparent"
    },
    {
      "id": "770d54cb-ac5",
      "type": "rectangle",
      "x": 520,
      "y": 810,
      "width": 420,
      "height": 370,
      "strokeColor": "#CC6600",
