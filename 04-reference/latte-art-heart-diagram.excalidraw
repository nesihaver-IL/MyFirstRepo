      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Milk temp: 60-65C\n(too hot kills the foam)\n\nMicrofoam texture:\nlike wet paint, no bubbles\n\nCup angle: 45 until\nhalf full, then flatten\n\nHIGH pour = milk sinks\nLOW pour = milk floats",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Milk temp: 60-65C\n(too hot kills the foam)\n\nMicrofoam texture:\nlike wet paint, no bubbles\n\nCup angle: 45 until\nhalf full, then flatten\n\nHIGH pour = milk sinks\nLOW pour = milk floats",
      "lineHeight": 1.25
    },
