    {
      "type": "text",
      "version": 1,
      "versionNonce": 881177,
      "isDeleted": false,
      "id": "elem_0072",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 495,
