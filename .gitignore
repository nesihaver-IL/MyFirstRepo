# Secrets — never commit
.env
*.env
!*.env.example
credentials.json
token.json

# Terraform state and local config
terraform.tfvars
*.tfvars
!*.tfvars.example
.terraform/
terraform.tfstate
terraform.tfstate.backup

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node
node_modules/

# Exclude whatsapp-export but allow the album index.html and photos
whatsapp-export/
!whatsapp-export/album/
!whatsapp-export/album/index.html
!whatsapp-export/album/photos/
!whatsapp-export/album/photos/*.jpg

# Windows metadata files (WSL copies from Windows)
# Note: WSL uses a Unicode lookalike colon (U+F03A), so omit the colon to match both variants
*Zone.Identifier

# IDE settings (machine-specific)
.vscode/

# Personal health data exports
01-personal/garmin-health/data/exports/*.csv

# Interview coach personal data
01-personal/interview-coach/Nesi_Haver_PDM.pdf
01-personal/interview-coach/memory/user_profile.md

# Python virtual environment (versioned)
.venv-1/

# Database files (runtime data, never committed)
*.db

# Large raw Garmin data exports
**/Garmin_full_Data_*/

# Raw unprocessed source data (personal exports, chat logs)
02-work/archive/genesis-feedback-storytelling/data/raw/

# Skill symlinks (WSL symlinks - Windows git cannot stage these; commit via WSL git)
.claude/skills/apply-comments
.claude/skills/create-slide
.claude/skills/create-theme
.claude/skills/current-slide
.claude/skills/slide-authoring

# Teams 365 folder with special Unicode character in name (duplicate of tracked Teams 365/)
# Pattern: [! ] matches any char that is NOT a space, so it catches the special-char variant
# but skips the clean "Teams 365/" folder (which starts with a space after Teams)
04-reference/Teams[! ]* 365/
